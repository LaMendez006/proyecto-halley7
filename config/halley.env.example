# =====================================================================
# Halley-7 · Configuración de ejemplo
#
# Copiar este archivo como config/halley.env y poner las claves reales:
#     cp config/halley.env.example config/halley.env
# config/halley.env está en .gitignore: las claves NUNCA se suben a Git.
# =====================================================================

# --- Conexión a PostgreSQL ---------------------------------------------
HALLEY_DB_HOST=localhost
HALLEY_DB_PORT=5432
HALLEY_DB_NAME=halley7

# Rol de la APLICACIÓN (lo usa Java). Solo tendrá INSERT y SELECT.
HALLEY_DB_USER=halley
HALLEY_DB_PASSWORD=cambiar_esta_clave

# Rol ADMINISTRADOR (solo lo usa scripts/setup_db.sh para crear la base,
# las tablas y los triggers; será el dueño de las tablas).
# En Ubuntu el usuario "postgres" no tiene clave por defecto; se le pone
# una sola vez con:
#     sudo -u postgres psql -c "ALTER USER postgres PASSWORD 'tu_clave'"
# En Windows y macOS es la clave que se definió al instalar PostgreSQL.
HALLEY_DB_ADMIN_USER=postgres
HALLEY_DB_ADMIN_PASSWORD=cambiar_esta_clave
# --- Puertos de los servicios (docs/contrato.md) -------------------------
HALLEY_JAVA_PORT=8080
HALLEY_PROLOG_PORT=8082
HALLEY_JULIA_PORT=8083
